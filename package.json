    "@types/node": "22.18.0",
    "@types/react": "18.3.24",
    "@types/react-dom": "18.3.7",
    "@types/react-test-renderer": "18.3.1",
    "playwright-core": "1.61.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-test-renderer": "18.3.1",
    "tsdown": "0.16.2",
    "typescript": "5.9.3",
