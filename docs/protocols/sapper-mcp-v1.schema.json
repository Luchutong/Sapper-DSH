{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sapper:protocol:mcp:1",
  "title": "Sapper MCP tool-broker protocol v1 (design)",
  "description": "Design contract, not a live API. Host derives identity, revisions, resource bindings and fencing. Schema validation never grants authority.",
  "oneOf": [
    {
      "$ref": "#/$defs/profile"
    },
    {
      "$ref": "#/$defs/selection"
    },
    {
      "$ref": "#/$defs/lease"
    },
    {
      "$ref": "#/$defs/invocation"
    },
    {
      "$ref": "#/$defs/receipt"
    },
    {
      "$ref": "#/$defs/observation"
    },
    {
      "$ref": "#/$defs/repair-plan"
    },
    {
      "$ref": "#/$defs/interactive-request"
    },
    {
      "$ref": "#/$defs/interactive-result"
    }
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "owner": {
      "type": "object",
      "properties": {
        "hostInstanceId": {
          "type": "string",
          "format": "uuid"
        },
        "workspaceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "challengeId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "taskId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "runId": {
          "type": "string",
          "pattern": "^r[0-9]{3,}$"
        },
        "agentId": {
          "type": "string",
          "format": "uuid"
        },
        "role": {
          "type": "string",
          "enum": [
            "reason",
            "explore",
            "verify",
            "writeup"
          ]
        }
      },
      "required": [
        "hostInstanceId",
        "workspaceId",
        "challengeId",
        "taskId",
        "runId",
        "agentId",
        "role"
      ],
      "additionalProperties": false
    },
    "resource": {
      "type": "object",
      "properties": {
        "backendId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "resourceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "kind": {
          "type": "string",
          "enum": [
            "ida-database",
            "debug-process",
            "remote-connection",
            "browser-context",
            "db-connection",
            "stateless",
            "generic"
          ]
        },
        "generation": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "backendId",
        "resourceId",
        "kind",
        "generation"
      ],
      "additionalProperties": false
    },
    "tool": {
      "type": "object",
      "properties": {
        "connectionRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "publicName": {
          "type": "string",
          "pattern": "^mcp__[A-Za-z0-9_.-]+__[A-Za-z0-9_.-]+$",
          "maxLength": 512
        },
        "schemaDigest": {
          "$ref": "#/$defs/digest"
        }
      },
      "required": [
        "connectionRef",
        "publicName",
        "schemaDigest"
      ],
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "properties": {
        "assetRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "uniqueItems": true
        },
        "assetDigests": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/digest"
          },
          "uniqueItems": true
        },
        "identities": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "asset",
                  "endpoint",
                  "database",
                  "opaque"
                ]
              },
              "value": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            },
            "required": [
              "type",
              "value"
            ],
            "additionalProperties": false
          },
          "uniqueItems": true
        },
        "binding": {
          "type": "string",
          "enum": [
            "attested",
            "unattested",
            "not-applicable"
          ]
        }
      },
      "required": [
        "assetRefs",
        "assetDigests",
        "binding"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "binding": {
                "const": "attested"
              }
            }
          },
          "then": {
            "anyOf": [
              {
                "properties": {
                  "assetDigests": {
                    "minItems": 1
                  }
                }
              },
              {
                "required": [
                  "identities"
                ],
                "properties": {
                  "identities": {
                    "minItems": 1
                  }
                }
              }
            ]
          }
        }
      ]
    },
    "revisions": {
      "type": "object",
      "properties": {
        "catalog": {
          "type": "integer",
          "minimum": 0
        },
        "policy": {
          "type": "integer",
          "minimum": 0
        },
        "hostPermissions": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "connector": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "catalog",
        "policy",
        "hostPermissions",
        "connector"
      ],
      "additionalProperties": false
    },
    "artifact": {
      "type": "object",
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "mediaType": {
          "type": "string",
          "minLength": 1
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "ref",
        "digest",
        "mediaType",
        "bytes"
      ],
      "additionalProperties": false
    },
    "profile": {
      "type": "object",
      "properties": {
        "protocol": {
          "const": "sapper-mcp/1"
        },
        "kind": {
          "const": "profile"
        },
        "profileId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "connectionRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "backendId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "resourcePolicy": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "ida-database",
                "debug-process",
                "remote-connection",
                "browser-context",
                "db-connection",
                "stateless",
                "generic"
              ]
            },
            "isolation": {
              "type": "string",
              "enum": [
                "stateless",
                "explicit-handle",
                "dedicated-instance",
                "exclusive-workflow",
                "generic-exclusive"
              ]
            },
            "assurance": {
              "type": "string",
              "enum": [
                "process",
                "verified-handle",
                "serialized",
                "stateless"
              ]
            },
            "lockScope": {
              "type": "string",
              "enum": [
                "backend",
                "resource"
              ]
            },
            "maxInstances": {
              "type": "integer",
              "minimum": 1
            },
            "maxInFlight": {
              "type": "integer",
              "minimum": 1
            },
            "identityCheck": {
              "type": "string",
              "enum": [
                "required",
                "best-effort",
                "not-applicable"
              ]
            },
            "fencing": {
              "type": "string",
              "enum": [
                "server-enforced",
                "worker-enforced",
                "unsupported"
              ]
            },
            "coordination": {
              "const": "host"
            }
          },
          "required": [
            "kind",
            "isolation",
            "assurance",
            "lockScope",
            "maxInstances",
            "maxInFlight",
            "identityCheck",
            "fencing",
            "coordination"
          ],
          "additionalProperties": false
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "toolRef": {
                "$ref": "#/$defs/tool"
              },
              "capability": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9]*(?:[.][a-z][a-z0-9-]*)+$",
                "maxLength": 160
              },
              "roles": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "explore",
                    "verify"
                  ]
                },
                "minItems": 1,
                "uniqueItems": true
              },
              "effect": {
                "type": "string",
                "enum": [
                  "read",
                  "write",
                  "execute",
                  "control",
                  "unknown"
                ]
              },
              "binding": {
                "type": "string",
                "enum": [
                  "explicit-handle",
                  "implicit-current",
                  "none"
                ]
              },
              "retry": {
                "type": "string",
                "enum": [
                  "never",
                  "idempotent"
                ]
              },
              "invalidates": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "none",
                    "state-revision",
                    "resource-epoch",
                    "asset-revision"
                  ]
                },
                "uniqueItems": true
              }
            },
            "required": [
              "toolRef",
              "capability",
              "roles",
              "effect",
              "binding",
              "retry",
              "invalidates"
            ],
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "invalidates": {
                      "contains": {
                        "const": "none"
                      }
                    }
                  }
                },
                "then": {
                  "properties": {
                    "invalidates": {
                      "maxItems": 1
                    }
                  }
                }
              }
            ]
          },
          "minItems": 1
        }
      },
      "required": [
        "protocol",
        "kind",
        "profileId",
        "revision",
        "connectionRef",
        "backendId",
        "resourcePolicy",
        "tools"
      ],
      "additionalProperties": false
    },
    "selection": {
      "type": "object",
      "properties": {
        "protocol": {
          "const": "sapper-mcp/1"
        },
        "kind": {
          "const": "selection"
        },
        "selectionId": {
          "type": "string",
          "format": "uuid"
        },
        "owner": {
          "$ref": "#/$defs/owner"
        },
        "revisions": {
          "$ref": "#/$defs/revisions"
        },
        "requiredCapabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:[.][a-z][a-z0-9-]*)+$",
            "maxLength": 160
          },
          "uniqueItems": true
        },
        "selected": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "toolRef": {
                "$ref": "#/$defs/tool"
              },
              "capability": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9]*(?:[.][a-z][a-z0-9-]*)+$",
                "maxLength": 160
              },
              "profileId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "toolRef",
              "capability",
              "profileId",
              "reason"
            ],
            "additionalProperties": false
          }
        },
        "excluded": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "publicName": {
                "type": "string",
                "pattern": "^mcp__[A-Za-z0-9_.-]+__[A-Za-z0-9_.-]+$",
                "maxLength": 512
              },
              "reason": {
                "type": "string",
                "enum": [
                  "scope-denied",
                  "activation-required",
                  "role-denied",
                  "capability-mismatch",
                  "resource-unavailable",
                  "adapter-unavailable",
                  "schema-changed"
                ]
              },
              "detail": {
                "type": "string"
              }
            },
            "required": [
              "publicName",
              "reason",
              "detail"
            ],
            "additionalProperties": false
          }
        },
        "missingCapabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:[.][a-z][a-z0-9-]*)+$",
            "maxLength": 160
          },
          "uniqueItems": true
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "protocol",
        "kind",
        "selectionId",
        "owner",
        "revisions",
        "requiredCapabilities",
        "selected",
        "excluded",
        "missingCapabilities",
        "createdAt"
      ],
      "additionalProperties": false
    },
    "lease": {
      "type": "object",
      "properties": {
        "protocol": {
          "const": "sapper-mcp/1"
        },
        "kind": {
          "const": "lease"
        },
        "leaseId": {
          "type": "string",
          "format": "uuid"
        },
        "requestId": {
          "type": "string",
          "format": "uuid"
        },
        "owner": {
          "$ref": "#/$defs/owner"
        },
        "resource": {
          "$ref": "#/$defs/resource"
        },
        "target": {
          "$ref": "#/$defs/target"
        },
        "mode": {
          "type": "string",
          "enum": [
            "exclusive-workflow",
            "isolated-handle",
            "dedicated-instance",
            "quota"
          ]
        },
        "state": {
          "type": "string",
          "enum": [
            "requested",
            "queued",
            "provisioning",
            "active",
            "draining",
            "released",
            "failed",
            "quarantined"
          ]
        },
        "assurance": {
          "type": "string",
          "enum": [
            "process",
            "verified-handle",
            "serialized",
            "stateless"
          ]
        },
        "fence": {
          "type": "integer",
          "minimum": 1
        },
        "epoch": {
          "type": "integer",
          "minimum": 1
        },
        "heartbeatAt": {
          "type": "string",
          "format": "date-time"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "coordination": {
          "const": "host"
        }
      },
      "required": [
        "protocol",
        "kind",
        "leaseId",
        "requestId",
        "owner",
        "target",
        "mode",
        "state",
        "assurance",
        "coordination"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "active",
                  "draining",
                  "released",
                  "quarantined"
                ]
              }
            }
          },
          "then": {
            "required": [
              "resource",
              "fence",
              "epoch",
              "heartbeatAt",
              "expiresAt"
            ]
          }
        }
      ]
    },
    "invocation": {
      "type": "object",
      "properties": {
        "protocol": {
          "const": "sapper-mcp/1"
        },
        "kind": {
          "const": "invocation"
        },
        "invocationId": {
          "type": "string",
          "format": "uuid"
        },
        "callId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "leaseId": {
          "type": "string",
          "format": "uuid"
        },
        "owner": {
          "$ref": "#/$defs/owner"
        },
        "toolRef": {
          "$ref": "#/$defs/tool"
        },
        "revisions": {
          "$ref": "#/$defs/revisions"
        },
        "resource": {
          "$ref": "#/$defs/resource"
        },
        "target": {
          "$ref": "#/$defs/target"
        },
        "fence": {
          "type": "integer",
          "minimum": 1
        },
        "epoch": {
          "type": "integer",
          "minimum": 1
        },
        "argumentsDigest": {
          "$ref": "#/$defs/digest"
        },
        "requestedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "protocol",
        "kind",
        "invocationId",
        "callId",
        "leaseId",
        "owner",
        "toolRef",
        "revisions",
        "resource",
        "target",
        "fence",
        "epoch",
        "argumentsDigest",
        "requestedAt"
      ],
      "additionalProperties": false
    },
    "receipt": {
      "type": "object",
      "properties": {
        "protocol": {
          "const": "sapper-mcp/1"
        },
        "kind": {
          "const": "receipt"
        },
        "receiptId": {
          "type": "string",
          "format": "uuid"
        },
        "invocationId": {
          "type": "string",
          "format": "uuid"
        },
        "callId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "owner": {
          "$ref": "#/$defs/owner"
        },
        "toolRef": {
          "$ref": "#/$defs/tool"
        },
        "resource": {
          "$ref": "#/$defs/resource"
        },
        "target": {
          "$ref": "#/$defs/target"
        },
        "epoch": {
          "type": "integer",
          "minimum": 1
        },
        "fence": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "success",
            "error",
            "cancelled",
            "delivery-unknown"
          ]
        },
        "source": {
          "type": "string",
          "enum": [
            "target",
            "attachment",
            "external-reference",
            "unbound"
          ]
        },
        "argumentsDigest": {
          "$ref": "#/$defs/digest"
        },
        "resultDigest": {
          "$ref": "#/$defs/digest"
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifact"
          }
        },
        "startedAt": {
          "type": "string",
          "format": "date-time"
        },
        "endedAt": {
          "type": "string",
          "format": "date-time"
        },
        "errorCode": {
          "type": "string",
          "enum": [
            "SCOPE_DENIED",
            "ACTIVATION_REQUIRED",
            "CAPABILITY_MISSING",
            "ADAPTER_UNAVAILABLE",
            "RESOURCE_BUSY",
            "TARGET_MISMATCH",
            "STALE_EPOCH",
            "LEASE_REVOKED",
            "SCHEMA_CHANGED",
            "DELIVERY_UNKNOWN",
            "RESOURCE_QUARANTINED",
            "TOOL_ERROR",
            "CANCELLED"
          ]
        }
      },
      "required": [
        "protocol",
        "kind",
        "receiptId",
        "invocationId",
        "callId",
        "owner",
        "toolRef",
        "resource",
        "target",
        "epoch",
        "fence",
        "status",
        "source",
        "argumentsDigest",
        "artifacts",
        "startedAt",
        "endedAt"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "success"
              }
            }
          },
          "then": {
            "required": [
              "resultDigest"
            ],
            "not": {
              "required": [
                "errorCode"
              ]
            }
          },
          "else": {
            "required": [
              "errorCode"
            ]
          }
        }
      ]
    },
    "validity": {
      "type": "object",
      "properties": {
        "scope": {
          "type": "string",
          "enum": [
            "asset",
            "environment",
            "resource-epoch",
            "state-revision"
          ]
        },
        "assetDigests": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/digest"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "environmentDigest": {
          "$ref": "#/$defs/digest"
        },
        "resource": {
          "$ref": "#/$defs/resource"
        },
        "epoch": {
          "type": "integer",
          "minimum": 1
        },
        "stateRevision": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "scope"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "scope": {
                "const": "asset"
              }
            }
          },
          "then": {
            "required": [
              "assetDigests"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "scope": {
                "const": "environment"
              }
            }
          },
          "then": {
            "required": [
              "assetDigests",
              "environmentDigest"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "scope": {
                "enum": [
                  "resource-epoch",
                  "state-revision"
                ]
              }
            }
          },
          "then": {
            "required": [
              "resource",
              "epoch"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "scope": {
                "const": "state-revision"
              }
            }
          },
          "then": {
            "required": [
              "stateRevision"
            ]
          }
        }
      ]
    },
    "observation": {
      "type": "object",
      "properties": {
        "protocol": {
          "const": "sapper-mcp/1"
        },
        "kind": {
          "const": "observation"
        },
        "observationId": {
          "type": "string",
          "format": "uuid"
        },
        "owner": {
          "$ref": "#/$defs/owner"
        },
        "claim": {
          "type": "string",
          "minLength": 1
        },
        "value": {},
        "unit": {
          "type": "string"
        },
        "basis": {
          "type": "string",
          "enum": [
            "tool-parsed",
            "agent-inferred"
          ]
        },
        "state": {
          "type": "string",
          "enum": [
            "observed",
            "inferred",
            "stale"
          ]
        },
        "receiptRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          },
          "uniqueItems": true
        },
        "validity": {
          "$ref": "#/$defs/validity"
        },
        "dependsOn": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          },
          "uniqueItems": true
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "protocol",
        "kind",
        "observationId",
        "owner",
        "claim",
        "value",
        "unit",
        "basis",
        "state",
        "receiptRefs",
        "validity",
        "dependsOn",
        "createdAt"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "basis": {
                "const": "tool-parsed"
              }
            }
          },
          "then": {
            "properties": {
              "receiptRefs": {
                "minItems": 1
              },
              "state": {
                "enum": [
                  "observed",
                  "stale"
                ]
              }
            }
          },
          "else": {
            "properties": {
              "state": {
                "enum": [
                  "inferred",
                  "stale"
                ]
              }
            }
          }
        }
      ]
    },
    "repair-plan": {
      "type": "object",
      "properties": {
        "protocol": {
          "const": "sapper-mcp/1"
        },
        "kind": {
          "const": "repair-plan"
        },
        "planId": {
          "type": "string",
          "format": "uuid"
        },
        "owner": {
          "$ref": "#/$defs/owner"
        },
        "failureReceiptRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "preserve": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          },
          "uniqueItems": true
        },
        "invalidate": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          },
          "uniqueItems": true
        },
        "resumeFrom": {
          "type": "string",
          "enum": [
            "current-state",
            "last-safe-checkpoint",
            "fresh-resource"
          ]
        },
        "replaySafeStepRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "uniqueItems": true
        },
        "nextCapability": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[.][a-z][a-z0-9-]*)+$",
          "maxLength": 160
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "protocol",
        "kind",
        "planId",
        "owner",
        "failureReceiptRefs",
        "preserve",
        "invalidate",
        "resumeFrom",
        "replaySafeStepRefs",
        "nextCapability",
        "reason",
        "createdAt"
      ],
      "additionalProperties": false
    },
    "interactive-request": {
      "type": "object",
      "properties": {
        "protocol": {
          "const": "sapper-mcp/1"
        },
        "kind": {
          "const": "interactive-request"
        },
        "requestId": {
          "type": "string",
          "format": "uuid"
        },
        "action": {
          "type": "string",
          "enum": [
            "start",
            "read",
            "write",
            "interrupt",
            "stop",
            "snapshot"
          ]
        },
        "sessionRef": {
          "type": "string",
          "format": "uuid"
        },
        "profileId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "assetRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "environmentRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "cursor": {
          "type": "integer",
          "minimum": 0
        },
        "waitMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 30000
        },
        "maxBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        },
        "encoding": {
          "type": "string",
          "enum": [
            "utf-8",
            "base64"
          ]
        },
        "data": {
          "type": "string",
          "maxLength": 1400000
        }
      },
      "required": [
        "protocol",
        "kind",
        "requestId",
        "action"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "action": {
                "const": "start"
              }
            }
          },
          "then": {
            "required": [
              "profileId",
              "assetRefs"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "sessionRef"
                  ]
                },
                {
                  "required": [
                    "data"
                  ]
                },
                {
                  "required": [
                    "cursor"
                  ]
                }
              ]
            }
          },
          "else": {
            "required": [
              "sessionRef"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "profileId"
                  ]
                },
                {
                  "required": [
                    "assetRefs"
                  ]
                },
                {
                  "required": [
                    "environmentRef"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "read"
              }
            }
          },
          "then": {
            "required": [
              "cursor"
            ]
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "cursor"
                  ]
                },
                {
                  "required": [
                    "waitMs"
                  ]
                },
                {
                  "required": [
                    "maxBytes"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "write"
              }
            }
          },
          "then": {
            "required": [
              "data",
              "encoding"
            ]
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "data"
                  ]
                },
                {
                  "required": [
                    "encoding"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "interactive-result": {
      "type": "object",
      "properties": {
        "protocol": {
          "const": "sapper-mcp/1"
        },
        "kind": {
          "const": "interactive-result"
        },
        "requestId": {
          "type": "string",
          "format": "uuid"
        },
        "sessionRef": {
          "type": "string",
          "format": "uuid"
        },
        "owner": {
          "$ref": "#/$defs/owner"
        },
        "resource": {
          "$ref": "#/$defs/resource"
        },
        "epoch": {
          "type": "integer",
          "minimum": 1
        },
        "state": {
          "type": "string",
          "enum": [
            "running",
            "stopped",
            "awaiting-input",
            "eof",
            "crashed",
            "error"
          ]
        },
        "delivery": {
          "type": "string",
          "enum": [
            "accepted",
            "unknown",
            "not-applicable"
          ]
        },
        "output": {
          "type": "object",
          "properties": {
            "cursor": {
              "type": "integer",
              "minimum": 0
            },
            "nextCursor": {
              "type": "integer",
              "minimum": 0
            },
            "hasMore": {
              "type": "boolean"
            },
            "encoding": {
              "type": "string",
              "enum": [
                "utf-8",
                "base64"
              ]
            },
            "data": {
              "type": "string",
              "maxLength": 1400000
            }
          },
          "required": [
            "cursor",
            "nextCursor",
            "hasMore",
            "encoding",
            "data"
          ],
          "additionalProperties": false
        },
        "receiptRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          },
          "uniqueItems": true
        },
        "errorCode": {
          "type": "string",
          "enum": [
            "CURSOR_EXPIRED",
            "DELIVERY_UNKNOWN",
            "TOOL_ERROR",
            "SCOPE_DENIED",
            "STALE_EPOCH",
            "RESOURCE_QUARANTINED"
          ]
        }
      },
      "required": [
        "protocol",
        "kind",
        "requestId",
        "sessionRef",
        "owner",
        "resource",
        "epoch",
        "state",
        "delivery",
        "output",
        "receiptRefs"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "delivery": {
                "const": "unknown"
              }
            }
          },
          "then": {
            "properties": {
              "errorCode": {
                "const": "DELIVERY_UNKNOWN"
              }
            },
            "required": [
              "errorCode"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "error"
              }
            }
          },
          "then": {
            "required": [
              "errorCode"
            ]
          }
        }
      ]
    }
  }
}
